# Load Testing Environment Configuration
# This is used by docker-compose.loadtest.yml

# Hashicorp vault connection (using dev vault container)
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=loadtest-root-token
VAULT_MOUNT=secret

# Use local vault mock for simpler setup
VAULT_LOCAL_MOCK=

# API Access tokens for endpoint integrations
EPDW_ACCESS_TOKEN=test-epdw-token
ADVISORY_ACCESS_TOKEN=test-advisory-token

# Feature flags
# Enable generic DIDCheck router for comprehensive testing
FEATURE_DIDCHECK_ROUTER=1
