
# Hashicorp vault connection.
VAULT_ADDR=
VAULT_TOKEN=
VAULT_MOUNT=secret

# If specified, use a local vault mock instead of making requests to vault.
VAULT_LOCAL_MOCK=

# API Access tokens for endpoint integrations.
EPDW_ACCESS_TOKEN=
ADVISORY_ACCESS_TOKEN=
DIDCHECK_ACCESS_TOKEN=
DEMODIV_ACCESS_TOKEN=

# Authentication configuration
# Login mode: "cs" (Common Services) or "mock" (local development)
LOGIN_MODE=mock

# Common Services API URL (required when LOGIN_MODE=cs)
CS_API_URL=https://dev.epycadvisory.amd.com/csapi

# CS Login page URL - where to redirect users for CS authentication
CS_LOGIN_URL=https://dev.epycadvisory.amd.com

# Secret for signing mock JWTs (auto-generated if not set)
MOCK_JWT_SECRET=

# Token expiry time in minutes (default: 60)
TOKEN_EXPIRY_MINUTES=60

# MongoDB connection pool settings
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=5
MONGO_MAX_IDLE_TIME_MS=30000
MONGO_WAIT_QUEUE_TIMEOUT_MS=5000
MONGO_POOL_MONITOR_INTERVAL=60

# Whether to return traceback to clients on unhandled errors
EXPOSE_ERROR_DETAILS=

# Feature flags. Set to "1" to enable or clear to disable.

# Whether to enable the DIDCheck routes.
FEATURE_DIDCHECK_ROUTER=

# Whether to enable the debug VC N-Quads endpoint (for debugging canonicalization).
FEATURE_DEBUG_VC_NQUADS=

# Whether to enable the /demodiv routes (for testing in dev/staging environments).
FEATURE_DEMODIV_ROUTER=

# Whether to enable the /docs route (for development reference).
FEATURE_DOCS_ROUTER=
